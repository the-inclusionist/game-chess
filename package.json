{
  "name": "@the-inclusionist/game-hartwig-chess",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Josef Hartwig's Bauhaus chess set (1924) in pseudo-3D, drawn with Zdog and composited with PixiJS, on the Inclusionist accessibility engine.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "validate": "npm run typecheck && vitest run && vite build"
  },
  "dependencies": {
    "@the-inclusionist/engine": "file:../SP-the-inclusionist-tracer",
    "@types/three": "^0.185.4",
    "chess.js": "^1.4.0",
    "three": "^0.185.1",
    "zdog": "^1.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/browser": "^4.0.0",
    "@vitest/browser-playwright": "^4.0.0",
    "playwright": "^1.49.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
